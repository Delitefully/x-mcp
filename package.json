  "type": "module",
  "description": "Local MCP server that emulates X's hosted MCP endpoint (api.x.com/mcp) for any MCP client",
  "bin": { "x-mcp": "./x-mcp.mjs" },
  "engines": { "node": ">=20" },
  "scripts": {
